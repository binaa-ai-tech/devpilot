# =============================================================================
# Environment variables DevPilot's scripts read. Copy to .env (gitignored) or,
# better, keep them in .devpilot/config.sh (gitignored; `/dp-setup tracker`
# writes it) or the secrets provider. A same-named environment variable always
# wins over .devpilot/config.sh. In CI, set them as pipeline secrets/variables.
# Every value below is a placeholder. NEVER commit real values.
# =============================================================================

# ── Tracker: Jira ────────────────────────────────────────────────────────────
# Used by: scripts/jira.sh (through scripts/tracker.sh)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=KEY

# ── Tracker / git host: Azure DevOps ─────────────────────────────────────────
# Used by: scripts/azdo.sh (Boards + Repos)
AZDO_ORG_URL=https://dev.azure.com/your-org
AZDO_PROJECT=your-project
AZDO_PAT=your-azdo-personal-access-token
# Optional: AZDO_TEAM (default "<project> Team"), AZDO_REPO (default: from the
# origin remote), AZDO_STORY_TYPE (default: detected from the process template)
AZDO_TEAM=
AZDO_REPO=
AZDO_STORY_TYPE=

# ── Tracker / git host: GitHub ───────────────────────────────────────────────
# Used by: scripts/github.sh (GH_TOKEN is accepted when GITHUB_TOKEN is unset)
GITHUB_TOKEN=your-github-token
GITHUB_ORG=your-org
GITHUB_REPO=your-repo

# ── Ticket keys ──────────────────────────────────────────────────────────────
# Used by: scripts/git-flow.sh (branch names)
TICKET_PREFIX=KEY

# ── Notifications (optional) ─────────────────────────────────────────────────
# Used by: scripts/notify.sh
NOTIFY_WEBHOOK=https://hooks.example.com/your-webhook
NOTIFY_EMAIL=your-email@example.com

# ── Deploy webhooks ──────────────────────────────────────────────────────────
# Used by: scripts/deploy.sh when the project has no deploy/deploy.sh.
# In CD, prefer one DEPLOY_HOOK secret scoped to each pipeline environment;
# DEPLOY_HOOK_<ENV> is the fallback when DEPLOY_HOOK is not set.
DEPLOY_HOOK=
DEPLOY_HOOK_DEV=https://deploy.example.com/hooks/your-dev-hook
DEPLOY_HOOK_SIT=https://deploy.example.com/hooks/your-sit-hook
DEPLOY_HOOK_UAT=https://deploy.example.com/hooks/your-uat-hook
DEPLOY_HOOK_PRD=https://deploy.example.com/hooks/your-prd-hook

# ── Environment URLs (smoke tests) ───────────────────────────────────────────
# Used by: scripts/smoke.sh (called by scripts/deploy.sh after every deploy)
DEV_API_URL=https://api-dev.example.com
DEV_FRONTEND_URL=https://dev.example.com
SIT_API_URL=https://api-sit.example.com
SIT_FRONTEND_URL=https://sit.example.com
UAT_API_URL=https://api-uat.example.com
UAT_FRONTEND_URL=https://uat.example.com
PRD_API_URL=https://api.example.com
PRD_FRONTEND_URL=https://www.example.com
# Optional: health path appended to <ENV>_API_URL, and the retry loop
SMOKE_API_PATH=/health
SMOKE_RETRIES=10
SMOKE_DELAY=15

# ── Approvals (optional) ─────────────────────────────────────────────────────
# Used by: scripts/setup-environments.sh, scripts/azdo.sh (default: you)
DEVPILOT_APPROVERS=

# ── Deploy targets (scripts/deploy-init.sh templates) ────────────────────────
# Read by deploy/deploy.sh for the target you chose (App Service, IIS or
# Kubernetes). In CD, set them per environment; leave unused ones empty.
# AZURE_CLIENT_ID=  AZURE_CLIENT_SECRET=  AZURE_TENANT_ID=  AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=  API_APP=  WEB_APP=  SLOT=
# SQL_SERVER=  SQL_DATABASE=  SQL_USER=  SQL_PASSWORD=  SQL_AUTH=
# REGISTRY=  REGISTRY_USER=  REGISTRY_PASSWORD=  KUBE_CONFIG=  KUBE_NAMESPACE=
# IIS_SERVER=  IIS_USER=  IIS_SSH_KEY=  IIS_API_PATH=  IIS_API_POOL=  IIS_WEB_PATH=  IIS_WEB_POOL=
